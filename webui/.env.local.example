# Copy this file to `.env.local` and adjust for local development.
#
# Dev mode (`make run`): the Next.js dev server runs on :3000 and talks to the
# Rust backend on :5790, so the backend URL must be set here.
#
# Prod single-binary mode (`make build`/`make run-prod`): the Rust binary serves
# both the dashboard and the API from one port. The Makefile builds the export
# with an EMPTY NEXT_PUBLIC_ROUTER_API_URL (relative URLs), so this value is
# ignored at that time.

NEXT_PUBLIC_ROUTER_API_URL=http://127.0.0.1:5790