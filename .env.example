# Copy this file to `.env` and adjust values for local development.
# Production should set real environment variables instead of committing `.env`.

# Application identity
APP_NAME=router_api_ai

# Server binding
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=5790

# Logging verbosity. Examples: error, warn, info, debug, trace.
RUST_LOG=info,tower_http=debug

# ------------------------------------------------------------------
# AI Router settings
# ------------------------------------------------------------------

# Admin key that unlocks the admin API and the Next.js dashboard. REQUIRED.
ROUTER_MASTER_KEY=change-me-admin-key

# Optional personal API keys seeded at startup (comma-separated).
# Create more keys later via the dashboard / admin API.
# ROUTER_API_KEYS=sk-router-first,sk-router-second

# Groq API keys, ordered by fallback priority (first is tried first).
# Each entry may optionally carry its own base URL: key@https://api.example.com/v1
GROQ_API_KEYS=your-groq-key-here

# OpenAI-compatible base URL (used when an entry above has no explicit @url).
ROUTER_GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA API keys, ordered by fallback priority (e.g. nvapi-...).
# Each entry may optionally carry its own base URL: key@https://integrate.api.nvidia.com/v1
NVIDIA_API_KEYS=nvapi-your-key-here

# NVIDIA NIM base URL (OpenAI-compatible)
ROUTER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model served by the router.
ROUTER_DEFAULT_MODEL=llama-3.3-70b-versatile

# SQLite database file.
ROUTER_DB_PATH=router.db

# Directory of the statically exported dashboard (webui/out), served on the
# same port by the router binary. Set to a dummy path to disable.
ROUTER_STATIC_DIR=webui/out

# Seconds a provider stays in cooldown after a failure (fallback to next).
# Model-specific failures (400/404) do not trigger cooldown — the key is fine,
# only the model id was wrong — and providers in cooldown are still retried as a
# last resort rather than failing the request outright.
ROUTER_PROVIDER_COOLDOWN_SECS=60

# Wall-clock budget for one provider+model attempt before rotating to the next.
ROUTER_ATTEMPT_TIMEOUT_SECS=90

# Model fallback ladders, tried in order on each provider (comma-separated).
# Leave unset to use the built-in defaults.
# ROUTER_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# ROUTER_NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-ultra-550b-a55b,google/gemma-4-31b-it
# Vision ladder is used whenever the request contains an image. Text-only models
# are never offered an image, regardless of the ladders above.
# ROUTER_VISION_FALLBACK_MODELS=google/diffusiongemma-26b-a4b-it,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,google/gemma-4-31b-it,minimaxai/minimax-m3

# Model each local agent CLI runs with when the request asks for `auto`.
# Local agents are the last-resort fallback, so these default to cheap models.
# ROUTER_AGY_MODEL=gemini-3.5-flash-low
# ROUTER_CLAUDE_MODEL=haiku

# Vision fallback through a local agent, used when every cloud vision model is
# exhausted. OpenCode and Codex accept image attachments on the command line;
# Agy and Claude Code do not and are excluded from image requests.
# ROUTER_OPENCODE_VISION_MODEL=opencode/x-preview-f-free
# ROUTER_CODEX_VISION_MODEL=

# Default daily token quota per key (0 = unlimited).
ROUTER_DAILY_QUOTA_TOKENS=1000000

# Local agent CLI execution timeout. Local providers are discovered from PATH.
ROUTER_CLI_TIMEOUT_SECS=120

# Working directory for local agent CLIs. They are invoked in safe/non-interactive modes.
ROUTER_AGENT_WORKDIR=.

# ---------------------------------------------------------------------------
# Local ALPR engine (python-alpr-local)
# ---------------------------------------------------------------------------

# Persistent inference server. Start it with:
#   nix-shell python-alpr-local/shell.nix \
#     --run "python-alpr-local/.venv/bin/python python-alpr-local/server.py"
# If it is unreachable the router falls back to spawning the CLI, which is
# correct but much slower because it reloads both ONNX models per request.
ALPR_LOCAL_URL=http://127.0.0.1:8791

# Budget for a local ALPR call (server or CLI) before it is abandoned.
ALPR_TIMEOUT_MS=15000

# Interpreter and entrypoint for the CLI fallback. Both default to paths inside
# the repository; set them if the venv or checkout lives elsewhere.
# ALPR_PYTHON=python-alpr-local/.venv/bin/python
# ALPR_SCRIPT_PATH=python-alpr-local/main.py

# Plate detector checkpoint. Measured on the 13 real harvested photos:
#   yolo-v9-t-384  CER 0.232  p50 258ms   (default)
#   yolo-v9-t-640  CER 0.462  p50 438ms
#   yolo-v9-s-608  CER 0.233  p50 674ms   (better on distant plates)
# ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
# ALPR_OCR_MODEL=cct-s-v2-global-model
# ALPR_DETECTOR_CONF=0.35
